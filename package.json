{
  "name": "ocean-drive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "test": "bun test",
    "test:browser": "playwright test",
    "assets:vessels": "bun scripts/generate-vessels.mjs",
    "assets:identity": "bun scripts/generate-identity.mjs",
    "assets:record": "bun scripts/record-assets.mjs",
    "assets:audit": "bun scripts/audit-assets.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "typecheck": "bun --bun next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "@react-three/fiber@9.7.0": "patches/@react-three%2Ffiber@9.7.0.patch"
  }
}

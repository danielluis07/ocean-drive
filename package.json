{
  "name": "ocean-drive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "test": "bun test",
    "test:browser": "playwright test",
    "assets:ship": "bun scripts/build-ship.ts",
    "landmarks:fetch": "bun scripts/fetch-landmark-sources.ts",
    "landmarks:build": "bun scripts/generate-landmarks.ts",
    "assets:identity": "bun scripts/generate-identity.mjs",
    "assets:record": "bun scripts/record-assets.mjs",
    "assets:audit": "bun scripts/audit-assets.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "typecheck": "bun --bun next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "three": "0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fontkit": "^2.0.4",
    "meshoptimizer": "1.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "@react-three/fiber@9.7.0": "patches/@react-three%2Ffiber@9.7.0.patch"
  }
}

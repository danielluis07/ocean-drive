--- /dev/null
+++ b/dist/timer-clock.cjs
@@ -0,0 +1,41 @@
+// Keep Fiber 9's public clock contract while using Three's supported timer.
+// The application owns visibility handling; no document listeners are attached.
+exports.createTimerClock = function createTimerClock(Timer) {
+  const timer = new Timer();
+  return {
+    autoStart: true,
+    startTime: 0,
+    oldTime: 0,
+    elapsedTime: 0,
+    running: false,
+    start() {
+      this.startTime = performance.now();
+      this.oldTime = this.startTime;
+      this.elapsedTime = 0;
+      timer.reset();
+      this.running = true;
+    },
+    stop() {
+      this.getElapsedTime();
+      this.running = false;
+      this.autoStart = false;
+    },
+    getElapsedTime() {
+      this.getDelta();
+      return this.elapsedTime;
+    },
+    getDelta() {
+      if (this.autoStart && !this.running) {
+        this.start();
+        return 0;
+      }
+      if (!this.running) return 0;
+      const now = performance.now();
+      timer.update(now);
+      this.oldTime = now;
+      const delta = timer.getDelta();
+      this.elapsedTime += delta;
+      return delta;
+    }
+  };
+};
